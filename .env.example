# Copie para .env e ajuste. NUNCA faça commit do .env real.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=relatorios@alfacontabil.example
SMTP_PASSWORD=troque-esta-senha

# true = usa STARTTLS (portas como 587). Use false só em servidor de teste local.
SMTP_STARTTLS=false

# true = salva cópia na pasta Enviados via IMAP. Desligue ao testar localmente.
SAVE_TO_SENT=false
