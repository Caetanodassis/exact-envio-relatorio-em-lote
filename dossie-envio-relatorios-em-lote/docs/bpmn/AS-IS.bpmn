<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_AsIs" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_AsIs"><bpmn:participant id="P_Esc" name="Escritório Contábil (Analista) — AS-IS" processRef="Proc_AsIs" /><bpmn:participant id="P_Cli" name="Empresa Cliente" /><bpmn:messageFlow id="MF1" name="E-mail com documento" sourceRef="T6" targetRef="P_Cli" /></bpmn:collaboration>
<bpmn:process id="Proc_AsIs" name="Envio de relatórios por e-mail aos clientes (AS-IS, manual)" isExecutable="false">
<bpmn:documentation>Processo atual, manual: o analista envia um e-mail por empresa, localizando o PDF, consultando o e-mail na planilha e anexando o documento. Pendências (empresa sem e-mail) vão para uma lista.</bpmn:documentation>
<bpmn:startEvent id="S1" name="Relatórios gerados"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
<bpmn:manualTask id="T1" name="Abrir a pasta de documentos"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:manualTask>
<bpmn:userTask id="T2" name="Localizar o documento da empresa"><bpmn:incoming>F2</bpmn:incoming><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing><bpmn:dataInputAssociation id="DIA1"><bpmn:sourceRef>DS_Pasta</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:userTask id="T3" name="Buscar o e-mail da empresa na planilha"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing><bpmn:dataInputAssociation id="DIA2"><bpmn:sourceRef>DS_Plan</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:userTask>
<bpmn:exclusiveGateway id="GW1" name="E-mail encontrado?" default="F6"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing><bpmn:outgoing>F6</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:userTask id="T5" name="Redigir e-mail com mensagem padrão e anexar o documento"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="T6" name="Enviar o e-mail"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:userTask>
<bpmn:userTask id="T4" name="Registrar pendência na lista"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:userTask>
<bpmn:exclusiveGateway id="GW2"><bpmn:incoming>F8</bpmn:incoming><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:exclusiveGateway id="GW3" name="Há mais empresas?" default="F12"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway>
<bpmn:endEvent id="E1" name="Envio concluído"><bpmn:incoming>F12</bpmn:incoming></bpmn:endEvent>
<bpmn:dataStoreReference id="DS_Pasta" name="Pasta de documentos" />
<bpmn:dataStoreReference id="DS_Plan" name="Planilha de clientes" />
<bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="GW1"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F5" name="Sim" sourceRef="GW1" targetRef="T5"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">e-mail encontrado</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F6" name="Não" sourceRef="GW1" targetRef="T4"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F7" sourceRef="T5" targetRef="T6"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F8" sourceRef="T6" targetRef="GW2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F9" sourceRef="T4" targetRef="GW2"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F10" sourceRef="GW2" targetRef="GW3"></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F11" name="Sim" sourceRef="GW3" targetRef="T2"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">há empresas restantes</bpmn:conditionExpression></bpmn:sequenceFlow>
<bpmn:sequenceFlow id="F12" name="Não" sourceRef="GW3" targetRef="E1"></bpmn:sequenceFlow>
<bpmn:textAnnotation id="N1"><bpmn:text>Problemas do AS-IS: 1 e-mail manual por empresa; risco de documento ou destinatário errado; sem registro automático dos envios; tempo alto.</bpmn:text></bpmn:textAnnotation><bpmn:association id="A_N1" sourceRef="N1" targetRef="T1" />
</bpmn:process>
<bpmndi:BPMNDiagram id="D_AsIs"><bpmndi:BPMNPlane id="Pl_AsIs" bpmnElement="Collab_AsIs">
<bpmndi:BPMNShape id="P_Esc_di" bpmnElement="P_Esc" isHorizontal="true"><dc:Bounds x="160" y="60" width="1340" height="450" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="P_Cli_di" bpmnElement="P_Cli" isHorizontal="true"><dc:Bounds x="900" y="570" width="420" height="70" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="222" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="200" y="322" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="300" y="260" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="450" y="260" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="600" y="260" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="GW1_di" bpmnElement="GW1" isMarkerVisible="true"><dc:Bounds x="760" y="275" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="725" y="328" width="120" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="860" y="260" width="130" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="1030" y="260" width="100" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="730" y="160" width="110" height="80" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="GW2_di" bpmnElement="GW2" isMarkerVisible="true"><dc:Bounds x="1170" y="275" width="50" height="50" /></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="GW3_di" bpmnElement="GW3" isMarkerVisible="true"><dc:Bounds x="1260" y="275" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1222" y="328" width="126" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="1400" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1375" y="322" width="86" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="DS_Pasta_di" bpmnElement="DS_Pasta"><dc:Bounds x="475" y="370" width="60" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="440" y="428" width="130" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="DS_Plan_di" bpmnElement="DS_Plan"><dc:Bounds x="625" y="370" width="60" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="590" y="428" width="130" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="N1_di" bpmnElement="N1"><dc:Bounds x="300" y="455" width="560" height="40" /></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="258" y="300" /><di:waypoint x="300" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="410" y="300" /><di:waypoint x="450" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="560" y="300" /><di:waypoint x="600" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="710" y="300" /><di:waypoint x="760" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="810" y="300" /><di:waypoint x="860" y="300" /><bpmndi:BPMNLabel><dc:Bounds x="822" y="282" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="785" y="275" /><di:waypoint x="785" y="240" /><bpmndi:BPMNLabel><dc:Bounds x="792" y="250" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="990" y="300" /><di:waypoint x="1030" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1130" y="300" /><di:waypoint x="1170" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="840" y="200" /><di:waypoint x="1195" y="200" /><di:waypoint x="1195" y="275" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1220" y="300" /><di:waypoint x="1260" y="300" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1285" y="275" /><di:waypoint x="1285" y="110" /><di:waypoint x="505" y="110" /><di:waypoint x="505" y="260" /><bpmndi:BPMNLabel><dc:Bounds x="1292" y="200" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="1310" y="300" /><di:waypoint x="1400" y="300" /><bpmndi:BPMNLabel><dc:Bounds x="1340" y="282" width="25" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="MF1_di" bpmnElement="MF1"><di:waypoint x="1080" y="340" /><di:waypoint x="1080" y="570" /><bpmndi:BPMNLabel><dc:Bounds x="1090" y="520" width="130" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="A_N1_di" bpmnElement="A_N1"><di:waypoint x="355" y="455" /><di:waypoint x="355" y="340" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="DIA1_di" bpmnElement="DIA1"><di:waypoint x="505" y="370" /><di:waypoint x="505" y="340" /></bpmndi:BPMNEdge>
<bpmndi:BPMNEdge id="DIA2_di" bpmnElement="DIA2"><di:waypoint x="655" y="370" /><di:waypoint x="655" y="340" /></bpmndi:BPMNEdge>
</bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
